# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
.coverage
htmlcov/

# 本地密钥（★ 提交前必须核对未被跟踪）
.env
.env.*
!.env.example

# 本地数据（★ db 是可丢弃缓存；reports / first_seen / signals 是入仓资产，不在此列）
data/*.db
data/*.db-journal
data/*.db-wal
_site/  # ★ L8-C：Pages 构建产物（CI 内生成，不入库）
data/cache/
data/logs/
data/tmp/

# ★ 个人兴趣清单：配置洁癖，别人 clone 下来不该带着你的方向
config/watchlist.local.yaml

# ★ 导出产物：vault 是独立的 private 仓库，与代码仓库物理隔离（§3.7.1）
#   注意：这只匹配名为 `vault` 的目录；仓库内的 `example_vault/` 不受影响（照常入仓）
vault/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp

# ★ 本地文档（负责人决定不入库）：审查报告 / 复盘归档 / 功能总览
#   仍在磁盘上，clear+init 后照常可读；进 .gitignore 只是保证 `git status` 不被它们弄脏，
#   并防止 `git add -A` 误提交。要入库时从这里删掉再 add。
docs/审查报告/
项目复盘归档/
docs/功能总览.md
